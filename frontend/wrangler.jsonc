{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ridi-discount-db",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4090f575c2714ef5bf013885ad26da84",
      // deploy 시 로컬 에뮬레이션 검사 통과용 더미 — 실제 접속에는 사용되지 않음
      "localConnectionString": "postgresql://dummy:dummy@localhost:5432/dummy"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "d2a3c0ad83414983afc8b9eb28699311"
    }
  ],
  "observability": {
    "enabled": true
  }
}
